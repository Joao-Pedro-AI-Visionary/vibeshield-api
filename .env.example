# Copie para .env (opcional). Todos os valores abaixo são os defaults.
PORT=8080
# Lista separada por vírgula, sem barra final
FRONTEND_URL=http://localhost:5173
MAX_DOWNLOAD_BYTES=52428800
MAX_FILE_BYTES=1048576
MAX_FILES=20000
SCAN_TIMEOUT_SECS=60
RATE_LIMIT_PER_MINUTE=10
GITHUB_CODELOAD_BASE=https://codeload.github.com
NPM_REGISTRY_BASE=https://registry.npmjs.org
PYPI_BASE=https://pypi.org
RUST_LOG=info
MAX_CONCURRENT_SCANS=2
# Só ative atrás de proxy confiável
TRUST_X_FORWARDED_FOR=false
